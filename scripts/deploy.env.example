# -----------------------------------------------------------------------------
# deploy.env.example — sample configuration for the cloud deployment scripts.
#
# Copy to scripts/deploy.env (GITIGNORED) and fill in real values, OR export the
# same variables in your shell. The scripts `source` scripts/deploy.env if present.
#
#   cp scripts/deploy.env.example scripts/deploy.env
#   $EDITOR scripts/deploy.env
#
# EVERY value below is a placeholder / example. Do NOT commit real account IDs,
# VPC / subnet / security-group IDs, ARNs, domains, secrets or passwords here.
# -----------------------------------------------------------------------------

# == Account / region ==========================================================
export AWS_REGION="us-west-2"
export ACCOUNT_ID="<ACCOUNT_ID>"                 # 12-digit AWS account id

# == Model (Bedrock inference profile + backing foundation model) ==============
# The execution-role policy scopes bedrock:InvokeModel* to the inference-profile
# ARN plus one foundation-model ARN per region the profile can route to. For a
# "us." cross-region profile that is us-east-1 / us-east-2 / us-west-2.
export MODEL_INFERENCE_PROFILE_ID="us.openai.gpt-5.6-sol"
export MODEL_FOUNDATION_ID="openai.gpt-5.6-sol"           # profile id without the "us." prefix
export MODEL_REGIONS="us-east-1 us-east-2 us-west-2"      # space-separated

# == Runtime image / repo / role ==============================================
export RUNTIME_NAME="dsh_agentcore"                       # ^[a-zA-Z][a-zA-Z0-9_]{0,47}$ (underscores, NOT hyphens)
export ECR_RUNTIME_REPO="dsh-agentcore-runtime"
export RUNTIME_IMAGE_TAG="v1"
export RUNTIME_EXEC_ROLE_NAME="dsh-agentcore-execution-role-${AWS_REGION}"
# Path to the built DSH monorepo checkout. Used by BOTH build-image.sh (Runtime
# closure staging) AND web-bff/capture-static.mjs (baking the DSH Web static
# closure into web-bff/static/ before the BFF image build).
export DSH_REPO_ROOT="<DSH_REPO_ROOT>"       # e.g. /path/to/deepseek-harness (built: pnpm run build)

# == Runtime VPC (VPC mode: no NAT / no IGW; egress only via VPC endpoints) ====
# REUSE=true  -> use the pre-existing IDs below (nothing is created).
# REUSE=false -> the script CREATES a dedicated VPC + 2 private subnets +
#                route table + 2 security groups + 6 interface endpoints + S3
#                gateway endpoint, then writes the new IDs to stdout.
export REUSE_RUNTIME_VPC="true"
# --- when REUSE_RUNTIME_VPC=true, supply existing ids: ---
export RUNTIME_VPC_ID="<VPC_ID>"
export RUNTIME_SUBNET_IDS="<SUBNET_ID_A> <SUBNET_ID_B>"   # 2 private subnets, MapPublicIp=false, different AZs
export RUNTIME_SG_ID="<RUNTIME_SG_ID>"                    # Runtime SG, inbound empty
export RUNTIME_ENDPOINT_SG_ID="<ENDPOINT_SG_ID>"          # Endpoint SG, inbound 443 from VPC CIDR only
# --- when REUSE_RUNTIME_VPC=false, supply new-VPC layout: ---
export RUNTIME_VPC_CIDR="10.20.0.0/16"
export RUNTIME_SUBNET_A_CIDR="10.20.1.0/24"
export RUNTIME_SUBNET_B_CIDR="10.20.2.0/24"
export RUNTIME_AZ_A="${AWS_REGION}a"
export RUNTIME_AZ_B="${AWS_REGION}b"
# S3 gateway-endpoint prefix list for the route table (lets ECR pull layers from
# S3 without a 0.0.0.0/0 route). Look up: aws ec2 describe-prefix-lists \
#   --filters Name=prefix-list-name,Values=com.amazonaws.${AWS_REGION}.s3
export S3_PREFIX_LIST_ID="<S3_PREFIX_LIST_ID>"

# == Cognito ===================================================================
export COGNITO_POOL_NAME="dsh-agentcore-users"
export COGNITO_CLIENT_NAME="dsh-bff"
# Comma-separated test-user emails. Passwords are generated at deploy time and
# stored ONLY in Secrets Manager (see COGNITO_TEST_USERS_SECRET) — never printed.
export TEST_USER_EMAILS="alice@dsh-agentcore.test,bob@dsh-agentcore.test"

# == Session Directory (DynamoDB) =============================================
export DDB_TABLE="dsh-session-directory"

# == Secrets Manager names (values live in Secrets Manager, never in git) ======
export COGNITO_CLIENT_SECRET_NAME="dsh-agentcore/cognito-client-secret"
export COGNITO_TEST_USERS_SECRET="dsh-agentcore/test-users"
export BFF_SESSION_COOKIE_SECRET_NAME="dsh-bff/session-cookie-secret"
export BFF_MEMORY_KEY_SECRET_NAME="dsh-bff/memory-key"
export BFF_ORIGIN_VERIFY_SECRET_NAME="dsh-bff/origin-verify"

# == BFF image / ECS / ALB / CloudFront =======================================
export ECR_BFF_REPO="dsh-bff"
export BFF_IMAGE_TAG="v4"
# Static closure capture (web-bff/capture-static.mjs). deploy-web.sh auto-captures
# when web-bff/static/ is absent; set CAPTURE_STATIC=true to force a refresh from
# `dsh web` (requires DSH_REPO_ROOT above). Leave false to reuse an existing closure.
export CAPTURE_STATIC="false"
export ECS_CLUSTER="dsh-bff-cluster"
export ECS_SERVICE="dsh-bff-svc"
export ECS_TASK_FAMILY="dsh-bff"
export ECS_TASK_CPU="512"
export ECS_TASK_MEMORY="1024"
export ECS_EXEC_ROLE_NAME="dsh-bff-execution-role"
export ECS_TASK_ROLE_NAME="dsh-bff-task-role"
export ALB_NAME="dsh-bff-alb"
export TG_NAME="dsh-bff-tg"
export BFF_CONTAINER_PORT="3090"
export BFF_LOG_GROUP="/ecs/dsh-bff"
export CLOUDFRONT_COMMENT="dsh-bff"

# CloudFront managed prefix list (origin-facing) for the ALB inbound SG.
# Look up: aws ec2 describe-managed-prefix-lists \
#   --filters Name=prefix-list-name,Values=com.amazonaws.global.cloudfront.origin-facing
export CLOUDFRONT_PREFIX_LIST_ID="<CLOUDFRONT_PREFIX_LIST_ID>"

# == BFF network (reuse an existing VPC that already has IGW + NAT) ============
# The BFF, unlike the Runtime, needs internet egress (Cognito, STS, DynamoDB,
# Secrets Manager, ECR, bedrock-agentcore) via NAT, and public subnets for the
# internet-facing ALB. These scripts REUSE an existing VPC; they do not build it.
export WEB_VPC_ID="<WEB_VPC_ID>"
export ALB_SUBNET_IDS="<PUBLIC_SUBNET_A> <PUBLIC_SUBNET_B>"   # public subnets (IGW) for the ALB
export ECS_SUBNET_IDS="<PRIVATE_SUBNET_A> <PRIVATE_SUBNET_B>" # private subnets (0.0.0.0/0 -> NAT) for the tasks

# == Tenant ====================================================================
export TENANT_ID="default"
